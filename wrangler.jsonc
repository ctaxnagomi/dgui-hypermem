{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dgui-hypermem",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Keep the workers.dev origin published. Defining routes implicitly flips
  // workers_dev to false, which 404s every workers.dev URL; without this the
  // deploy silently kills the fallback origin.
  "workers_dev": true,
  // Custom domains, all serving this one script. dgui-hmem is the primary
  // hostname that the docs, CRM token JSON and MCP configs all advertise.
  // dgui-hypermem is the matching-name alias; hmem-admin backs the admin UI.
  // Every hostname is listed here, including the two that predate this file,
  // so wrangler's reconciliation is a no-op rather than a removal.
  "routes": [
    { "pattern": "dgui-hmem.deckergui.my", "custom_domain": true },
    { "pattern": "dgui-hypermem.deckergui.my", "custom_domain": true },
    { "pattern": "hmem-admin.deckergui.my", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dgui-hypermem-20260930-2300",
      "database_id": "735892ec-f246-4106-b770-4a9541ef982c"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "dgui-hypermem-20260930-2300"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "vars": {
    "JEV_MODE": "auto",
    "JEV_MODEL": "jev-latest",
    "JEV_ENDPOINT": "https://api.typesafe.ai",
    "EMBED_MODEL": "@cf/baai/bge-base-en-v1.5",
    "FALLBACK_MODEL": "@cf/meta/llama-3.1-8b-fast-v2",
    "DEFAULT_SCOPE": "default",
    "SALIENCE_GATE": 3.0,
    "HF_DATASET": "ctaxnagomi/DGUI_HYPERMEM-JEV"
  }
}
