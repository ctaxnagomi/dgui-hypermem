# Secrets & local state — never commit
.dev.vars
.token
.hftoken
*.token
.env
.env.*

# Admin device private key (admin-device.mjs writes this next to itself)
.admin-device-key.json

# Defensive net. No tracked file matches any pattern below (verified with
# `git ls-files | grep`), so these cannot hide source. They exist to catch a
# credential written by a future script under a name I have not anticipated —
# a key exported for debugging is the failure mode, not a missing entry.
*.pem
*.key
*.p12
*.pfx
*token*.json
*secret*.json
*credential*

# Dependencies & build
node_modules/
dist/
.wrangler/

# Logs
*.log
npm-debug.log*

# Python test residue
__pycache__/
*.pyc

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
token-wan.md

# Concrete training-governance grants — owner-only, never commit.
# Templates (placeholder-form) are the committed equivalents: ruleset/templates/
ruleset/DGUI_HMEM_RULESET.md
ruleset/DECKERGUI_SDK_RULESET.md
ruleset/DGUI_HMEM_RULESET_INSTRUCT/
ruleset/DGUI_HMEM_RULESET_INSTRUCT.zip
